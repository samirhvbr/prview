# Copy with `npm run setup`, then edit .env. Never commit real credentials.
# Any GitHub username; this is the author whose open pull requests are listed.
GITHUB_USERNAME=samirhvbr

# GitHub credential used only by the server. Prefer the minimum read access.
GITHUB_TOKEN=your_github_token_here

# Independent random secret, 32–256 URL-safe characters. Generated by setup.
# This is the token in the TV link, NEVER your GitHub token.
DASHBOARD_TOKEN=

# Loopback by default. Use 0.0.0.0 only to accept connections from other devices.
HOST=127.0.0.1
PORT=3000

# GitHub refresh interval (30–86400 seconds), shared by all connected TVs.
REFRESH_SECONDS=120
# Automatic page rotation interval (5–300 seconds).
PAGE_SECONDS=20
# Age in days used to flag an inactive PR (1–365).
STALE_DAYS=7

# Set true when the browser accesses the dashboard over HTTPS.
# Keep false for local HTTP development.
COOKIE_SECURE=false

# Docker Compose only: default host binding is local to this machine.
# Set to a specific LAN address, or 0.0.0.0, to allow other devices.
BIND_ADDRESS=127.0.0.1
